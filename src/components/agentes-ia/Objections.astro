---
import { objections, guaranteeObjection as g } from "../../data/agentes-ia";
---

<section class="py-16 md:py-20" aria-labelledby="dudas-title">
  <div class="container mx-auto px-6">
    <div class="text-center mb-12 md:mb-16">
      <p class="text-sm text-primary font-semibold uppercase tracking-wider mb-3 animate-on-scroll">Tus dudas, resueltas</p>
      <h2 id="dudas-title" class="text-3xl md:text-4xl font-bold text-white animate-on-scroll delay-100">
        Lo que todos se preguntan antes de empezar
      </h2>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto">
      {objections.map((o) => (
        <article class="obj animate-on-scroll">
          <h3 class="font-semibold text-lg text-white mb-2">“{o.q}”</h3>
          <p class="text-accent text-[0.9375rem] leading-relaxed">{o.a}</p>
        </article>
      ))}

      <article class="obj obj--featured md:col-span-2 lg:col-span-3 animate-on-scroll">
        <svg class="shrink-0 w-10 h-10 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
        <div>
          <h3 class="font-bold text-xl md:text-2xl text-white mb-2">“{g.q}”</h3>
          <p class="text-accent text-base md:text-lg leading-relaxed">{g.a}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .obj {
    padding: 1.5rem;
    border: 1px solid var(--color-secondary);
    border-radius: 1.25rem;
    background: rgba(0, 0, 0, 0.55);
  }

  .obj--featured {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 1.5rem;
    border: 2px solid transparent;
    background:
      linear-gradient(rgb(14, 44, 45), rgb(14, 44, 45)) padding-box,
      linear-gradient(135deg, var(--color-accent), var(--color-primary)) border-box;
  }

  @media (min-width: 768px) {
    .obj--featured {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
      padding: 2rem 2.5rem;
    }
  }
</style>
