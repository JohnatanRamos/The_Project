---
import { faqs } from "../../data/agentes-ia";
---

<section id="faq" class="py-16 md:py-20" aria-labelledby="faq-title">
  <div class="container mx-auto px-6">
    <h2 id="faq-title" class="text-3xl md:text-4xl font-bold text-white text-center mb-12 animate-on-scroll">
      Preguntas frecuentes
    </h2>
    <div class="max-w-3xl mx-auto space-y-4">
      {faqs.map((f) => (
        <details class="agent-faq faq-item glass-card overflow-hidden rounded-2xl animate-on-scroll">
          <summary class="p-6 cursor-pointer flex justify-between items-center gap-4">
            <h3 class="font-semibold text-lg">{f.q}</h3>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 w-5 h-5 transition-transform duration-300" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </summary>
          <div class="bg-secondary/50 p-6 -mt-2">
            <p class="text-sm">{f.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  details[open] svg {
    transform: rotate(180deg);
  }
  details[open] summary ~ * {
    animation: faqFadeIn 0.3s ease-in-out;
  }
  @keyframes faqFadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLDetailsElement>(".agent-faq");
  items.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (item.open) items.forEach((other) => other !== item && (other.open = false));
    });
  });
</script>
