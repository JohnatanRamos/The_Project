---
import { accompaniment as a } from "../../data/planes";
---

<section class="py-16 md:py-20" aria-labelledby="acompanamiento-title">
  <div class="container mx-auto px-6">
    <div class="acc-box max-w-4xl mx-auto">
      <div class="md:grid md:grid-cols-[1fr_auto] md:gap-12">
        <div>
          <h2 id="acompanamiento-title" class="text-3xl md:text-4xl font-bold text-white mb-4">{a.title}</h2>
          <p class="text-lg text-accent mb-8">{a.text}</p>

          <h3 class="font-semibold text-white mb-3">{a.listTitle}</h3>
          <ul class="acc-list">
            {a.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="acc-prices mt-10 md:mt-0">
          {a.prices.map((p) => (
            <p>
              <span class="block text-3xl font-bold text-white">{p.amount}</span>
              {p.label && <span class="block text-accent">{p.label}</span>}
            </p>
          ))}
        </div>
      </div>

      <p class="mt-10 pt-6 border-t border-secondary text-sm text-accent">{a.note}</p>
    </div>
  </div>
</section>

<style>
  .acc-box {
    padding: 2rem 1.5rem;
    border: 1px solid var(--color-secondary);
    border-radius: 1.5rem;
    background: rgba(0, 0, 0, 0.55);
  }
  @media (min-width: 768px) {
    .acc-box {
      padding: 3rem;
    }
  }
  .acc-list {
    display: grid;
    gap: 0.6rem;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--color-text);
  }
  .acc-list li::marker {
    color: var(--color-primary);
  }
  .acc-prices {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .acc-prices {
      padding-left: 2.5rem;
      border-left: 1px solid var(--color-secondary);
      justify-content: center;
    }
  }
</style>
