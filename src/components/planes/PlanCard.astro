---
import type { Plan } from "../../data/planes";
import data from "../../config/phone_messages.json";

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;
const waText = encodeURIComponent(data.plan_message.replace("{plan}", plan.name));
const waHref = `https://wa.me/${data.phone_number}?text=${waText}`;
const headingId = `plan-${plan.id}`;
---

<article
  class:list={["plan-card", { "plan-card--featured": plan.featured }]}
  aria-labelledby={headingId}
>
  {plan.badge && <p class="plan-badge">{plan.badge}</p>}

  <header class="mb-6">
    <h2 id={headingId} class="text-2xl font-bold text-white">{plan.name}</h2>
    <p class="mt-1 text-accent">{plan.tagline}</p>
    <p class="plan-price mt-5 font-bold text-white leading-none">{plan.price}</p>
    <p class="plan-delivery mt-3">{plan.delivery}</p>
  </header>

  {plan.includesFrom && (
    <p class="mb-3 font-semibold text-white">Todo lo de {plan.includesFrom}, más:</p>
  )}
  <ul class="plan-list">
    {plan.features.map((item) => <li>{item}</li>)}
  </ul>

  {plan.extra && (
    <div class="plan-extra">
      <h3 class="font-semibold text-white mb-3">{plan.extra.title}</h3>
      <ul class="plan-list">
        {plan.extra.items.map((item) => <li>{item}</li>)}
      </ul>
      <p class="mt-4 text-sm text-accent">{plan.extra.note}</p>
    </div>
  )}

  <div class="plan-action">
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      class:list={["btn w-full", plan.featured ? "btn-primary" : "btn-secondary"]}
    >
      Quiero el plan {plan.name}
    </a>
  </div>
</article>

<style>
  .plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.5rem;
    border: 1px solid var(--color-secondary);
    border-radius: 1.5rem;
    background: rgba(0, 0, 0, 0.55);
  }

  /* El único lugar con énfasis visual de la página */
  .plan-card--featured {
    border: 2px solid transparent;
    background:
      linear-gradient(rgb(14, 44, 45), rgb(14, 44, 45)) padding-box,
      linear-gradient(135deg, var(--color-accent), var(--color-primary)) border-box;
  }

  @media (min-width: 1024px) {
    .plan-card {
      padding: 2.25rem 2rem;
    }
    .plan-card--featured {
      margin-block: -1rem;
      padding-block: 3.25rem;
    }
  }

  .plan-badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 0.3rem 1rem;
    border-radius: 9999px;
    background: var(--color-accent);
    color: var(--color-base);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .plan-price {
    font-size: 2.5rem;
  }

  .plan-delivery {
    display: inline-block;
    padding: 0.2rem 0.75rem;
    border: 1px solid rgba(84, 197, 197, 0.45);
    border-radius: 9999px;
    color: var(--color-accent);
    font-size: 0.8125rem;
  }

  .plan-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    color: var(--color-text);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .plan-list li {
    position: relative;
    padding-left: 1.6rem;
  }

  .plan-list li::before {
    content: "";
    position: absolute;
    left: 0.15rem;
    top: 0.45em;
    width: 0.8rem;
    height: 0.45rem;
    border-left: 2px solid var(--color-primary);
    border-bottom: 2px solid var(--color-primary);
    transform: rotate(-45deg);
  }

  .plan-extra {
    margin-top: 1.75rem;
    padding: 1.25rem;
    border-radius: 1rem;
    background: rgba(28, 93, 95, 0.45);
    border-left: 3px solid var(--color-primary);
  }

  /* El botón queda al fondo para que las tarjetas alineen en escritorio */
  .plan-action {
    margin-top: auto;
    padding-top: 2rem;
  }
</style>
