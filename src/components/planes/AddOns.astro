---
import { addOns } from "../../data/planes";
---

<section class="py-16 md:py-20" aria-labelledby="addons-title">
  <div class="container mx-auto px-6 max-w-4xl">
    <h2 id="addons-title" class="text-3xl md:text-4xl font-bold text-white mb-8">Potencia tu tienda con extras</h2>

    <table class="addons-table">
      <thead>
        <tr>
          <th scope="col">Add-on</th>
          <th scope="col">Descripción</th>
          <th scope="col" class="text-right">Precio</th>
        </tr>
      </thead>
      <tbody>
        {addOns.map((addon) => (
          <tr>
            <th scope="row">{addon.name}</th>
            <td>{addon.description}</td>
            <td class="addon-price">{addon.price}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <p class="mt-8 text-accent">¿Necesitas algo que no está aquí? Lo cotizamos según tu proyecto.</p>
  </div>
</section>

<style>
  .addons-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  .addons-table thead th {
    padding: 0 1rem 0.75rem 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-primary);
  }
  .addons-table tbody tr {
    border-bottom: 1px solid var(--color-secondary);
  }
  .addons-table tbody th,
  .addons-table td {
    padding: 1rem 1rem 1rem 0;
    vertical-align: top;
  }
  .addons-table tbody th {
    font-weight: 600;
    color: var(--color-white);
  }
  .addons-table td {
    color: var(--color-text);
    font-size: 0.9375rem;
  }
  .addon-price {
    text-align: right;
    font-weight: 600;
    color: var(--color-white) !important;
    white-space: nowrap;
    padding-right: 0 !important;
  }

  /* Móvil: cada fila se vuelve un bloque nombre + precio, descripción debajo */
  @media (max-width: 767px) {
    .addons-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .addons-table tbody tr {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: 1rem;
      padding: 1rem 0;
    }
    .addons-table tbody th,
    .addons-table td {
      padding: 0;
    }
    .addons-table td:not(.addon-price) {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 0.25rem;
      font-size: 0.875rem;
    }
    .addons-table td:empty {
      display: none;
    }
    .addon-price {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
